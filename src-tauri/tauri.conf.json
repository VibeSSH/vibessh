{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeSSH",
  "version": "0.1.0-beta.7",
  "identifier": "dev.vibessh.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeSSH",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE.txt",
    "windows": {
      "nsis": {
        "headerImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "Polish",
          "English"
        ],
        "customLanguageFiles": {
          "Polish": "nsis/Polish.nsh"
        },
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMkE5MjhENTg5MTdERjcKUldUM2ZaRllqWklxMnVTaGdNVUhzdHhOQ3VHU3Z1bnVMVjNiR0tubjkyZExTc2lTb05zbERtK2kK",
      "endpoints": [
        "https://github.com/VibeSSH/vibessh-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
