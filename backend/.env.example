# Copy to .env for local development (not committed - see .gitignore).
DATABASE_URL=postgres://vibessh_app:PASSWORD@localhost:5432/vibessh
VIBESSH_BACKEND_BIND=127.0.0.1:8787
# Signs/verifies access tokens - generate a real one, e.g. `openssl rand -base64 48`.
# Rotating this invalidates every currently-issued access token (they just
# fail verification and the client re-authenticates via its still-valid
# refresh token) - refresh tokens aren't affected, they're never signed with
# this secret, see refresh_token.rs.
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-bytes-long

# ---- Hosted Vibe AI assistant (optional) ----
#
# Set all three to offer the "Included with VibeSSH" model in the desktop
# app's Settings. Leave them unset and the endpoint reports that this
# deployment has no included model - users then bring their own API key,
# which needs nothing here.
#
# The key stays in this process. It is never sent to a client, and that is
# the whole reason the desktop proxies through this endpoint instead of
# talking to the provider directly: a key shipped inside a desktop binary is
# a published key, and no client-side limit survives someone holding it.
AI_UPSTREAM_BASE_URL=https://ws-example.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_UPSTREAM_API_KEY=replace-with-the-provider-key
AI_UPSTREAM_MODEL=qwen-max
# Questions per account per UTC day. Defaults to 20 when unset. This is what
# stops one account spending the shared allowance; it is enforced here, in
# one atomic statement per request, not in the app.
AI_DAILY_QUESTION_LIMIT=20
