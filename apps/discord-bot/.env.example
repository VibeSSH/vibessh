# The bot's token, from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=

# The application (client) id, from the Developer Portal (General Information).
CLIENT_ID=

# The guild (server) id the bot manages. Right-click the server -> Copy Server ID
# (Developer Mode must be on). Slash commands are registered to this guild only,
# so they appear instantly instead of taking up to an hour to propagate.
GUILD_ID=

# Where the bot reads the live status shown on the voice channels - the current
# version and the download count. Expected to answer with JSON shaped like:
#   { "version": "0.1.0-beta.18", "downloads": 1234 }
# Leave blank to fall back to STATUS_FALLBACK_* below until the endpoint exists.
STATUS_URL=

# Shown while STATUS_URL is unset or unreachable.
STATUS_FALLBACK_VERSION=0.1.0-beta.18
STATUS_FALLBACK_DOWNLOADS=0
