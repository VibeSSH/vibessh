node_modules/
dist/
target/
apps/desktop/src-tauri/gen/
*.log
.DS_Store
.env

# proptest writes a failing case here so it is replayed first on the next run.
# Committed deliberately when a property test finds a real bug - the file is
# the regression test. Ignored otherwise so a transient local failure does not
# arrive in a diff as noise.
apps/desktop/src-tauri/proptest-regressions/
apps/desktop/src-tauri/tests/*.proptest-regressions

# Playwright (desktop UI e2e/visual regression)
apps/desktop/ui/test-results/
apps/desktop/ui/playwright-report/
apps/desktop/ui/blob-report/
apps/desktop/ui/.playwright/
